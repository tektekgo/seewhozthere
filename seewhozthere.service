[Unit]
Description=SeeWhozThere Face Detection and Recognition Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pimediaadmin
Group=pimediaadmin
WorkingDirectory=/home/pimediaadmin/projects/seewhozthere
Environment="PATH=/home/pimediaadmin/projects/seewhozthere/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /home/pimediaadmin/projects/seewhozthere/run_service.py
Restart=always
RestartSec=10
StandardOutput=append:/home/pimediaadmin/projects/seewhozthere/data/service.log
StandardError=append:/home/pimediaadmin/projects/seewhozthere/data/service.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
