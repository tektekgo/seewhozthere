[GENERAL]
# Your timezone (e.g., America/New_York, Europe/London, Asia/Kolkata, UTC)
# NOTE: Do NOT use quotes around values in .ini files
timezone = America/New_York

# Port for the web server
port = 7222

# Database file path (relative to project root)
database_path = data/seewhozthere.db

[SCHEDULER]
# Enable daily summary notifications
enabled = false

# Time to send daily summary (24-hour format, HH:MM)
send_time = 20:00

# Notification service: telegram or email
service = telegram

[TELEGRAM]
# Telegram bot token (get from @BotFather)
# Leave empty until you set up a bot
bot_token = 

# Your Telegram chat ID
chat_id = 

[EMAIL]
# Email settings (for future use)
smtp_server = smtp.gmail.com
smtp_port = 587
sender_email = 
sender_password = 
recipient_email = 

[SECURITY]
# Passphrase to access the dashboard.
# IMPORTANT: Change this before sharing the app with anyone.
# Leave blank to disable login entirely (not recommended if accessible from outside your home).
passphrase = changeme

# How long a login session lasts in hours before the user must log in again
session_hours = 24

[DETECTION]
# How many seconds to wait before saving another snapshot of the same camera.
# Lower values = more photos per person per visit (e.g., 2 = up to 30 photos/minute).
# Higher values = fewer photos (e.g., 30 = one photo per 30 seconds per camera).
# Recommended: 15-30 seconds for normal use.
snapshot_cooldown_seconds = 15

# Minimum confidence score (0.0 to 1.0) for a face detection to be recorded.
# Higher values = fewer false positives but may miss some real faces.
# Recommended: 0.6 for indoor cameras, 0.80-0.85 for outdoor cameras.
confidence_threshold = 0.6

# Minimum face size in pixels (width x height) to be recorded.
# Rejects small distant detections caused by foliage, shadows, or passing cars.
# Recommended: 50x50 for indoor cameras, 80x80 or higher for outdoor cameras.
min_face_width = 80
min_face_height = 80


[DETECTION_ZONES]
# Optional: restrict face detection to a specific region of the camera frame.
# This is the most effective way to eliminate false positives from background
# light sources, trees, or distant objects that are in the same frame as the
# area you actually want to monitor.
#
# Format: camera_name = x1,y1,x2,y2
# Values are PERCENTAGES (0-100) of the frame width and height.
#   x1,y1 = top-left corner of the zone
#   x2,y2 = bottom-right corner of the zone
#
# Example: only detect faces in the center-bottom area of the frame
# (useful for a front door camera where the door is in the lower-center)
#   front_door = 20,40,80,100
#   (ignores top 40% of frame and left/right 20% margins)
#
# To find the right values for your camera:
#   1. Take a screenshot of your camera feed
#   2. Identify the area where a real person would appear
#   3. Estimate the percentage coordinates of that area
#   4. Start conservative (large zone) and narrow it down over time
#
# Leave this section empty or remove camera entries to use the full frame.
# front_door = 20,40,80,100

[TELEGRAM_ALERTS]
# Minimum minutes between Telegram alerts for the SAME camera.
# This prevents alert flooding when a light, tree, or background object
# repeatedly triggers the camera. Set to 0 to disable cooldown (not recommended).
# Recommended: 5 minutes for outdoor cameras, 2 minutes for indoor cameras.
alert_cooldown_minutes = 5

# Minimum minutes between Telegram alerts for the SAME known visitor.
# Prevents repeated "Sujit spotted" alerts when someone stays in frame.
# Set to 0 to alert on every single detection.
known_visitor_alert_cooldown_minutes = 10

[CAMERAS]
# Add your camera RTSP streams here
# Format: camera_name = rtsp://username:password@ip:port/stream
# NOTE: Do NOT use quotes around the RTSP URLs
# Example:
# front_door = rtsp://admin:password@192.168.1.100:554/stream1
# driveway = rtsp://admin:password@192.168.1.101:554/stream1
