[Unit]
Description=SeeWhozThere Web Dashboard
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/seewhozthere
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="APP_ENV=production"
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 7222
Restart=always
RestartSec=5
StandardOutput=append:/home/pi/seewhozthere/data/web.log
StandardError=append:/home/pi/seewhozthere/data/web.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
